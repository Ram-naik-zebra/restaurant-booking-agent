# Which LLM provider the agent loop should use: "ollama" (local dev) or "gemini" (production)
LLM_PROVIDER=ollama

# --- Ollama (local dev) ---
# Ollama must be running locally with a tool-calling-capable model pulled, e.g.:
#   ollama pull llama3.1:8b
OLLAMA_BASE_URL=http://localhost:11434/v1
OLLAMA_MODEL=llama3.1:8b

# --- Gemini (production) ---
# Get a free API key at https://aistudio.google.com/app/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
# Note: as of late 2026, older models (gemini-2.0-flash, gemini-2.5-flash, etc.)
# are no longer available to new API keys - gemini-3.8-flash is the only
# generally-available flash model for new accounts.

# Server
PORT=4000
# Comma-separated list of allowed frontend origins (for CORS)
CORS_ORIGIN=http://localhost:5173
